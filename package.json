{
  "name": "bookshop-api",
  "version": "1.0.0",
  "description": "API REST para una plataforma de compraventa de libros de segunda mano",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "prettier": "prettier --check src/",
    "prettier:fix": "prettier --write src/",
